<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.kolomyychenkoai</groupId>
    <artifactId>allure-spring-test</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>allure-spring-test</name>
    <description>Zero-config Allure reporting for Spring tests: application logs, configuration
        snapshots and HTTP request/response (MockMvc and RestAssured), attached automatically —
        no test code changes.</description>
    <url>https://github.com/kolomyychenkoai/allure-spring-test</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kolomyychenkoai</id>
            <url>https://github.com/kolomyychenkoai</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/kolomyychenkoai/allure-spring-test.git</connection>
        <developerConnection>scm:git:git@github.com:kolomyychenkoai/allure-spring-test.git</developerConnection>
        <url>https://github.com/kolomyychenkoai/allure-spring-test</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <spring-boot.version>3.5.8</spring-boot.version>
        <allure.version>2.25.0</allure.version>
        <allure-maven.version>2.12.0</allure-maven.version>
        <!-- Версия ЯВНАЯ, не из Boot BOM: в spring-boot-dependencies 4.1 rest-assured больше
             НЕ УПРАВЛЯЕТСЯ (в 3.5.8 был 5.5.6). Без пина ветка апгрейда падает на построении
             модели Maven («version is missing») ЕЩЁ ДО компиляции — то есть раньше всех наших
             сигналов, и разбираться будет не с чем. Значение равно тому, что даёт BOM 3.5.8,
             поэтому здесь это no-op. ⚠️ В ветке апгрейда пина МАЛО: Boot 4.1 тянет groovy-bom 5,
             а RA 5.5.6 собран на Groovy 4 → там нужна rest-assured 6.x. См. docs/upgrade-checklist.md. -->
        <rest-assured.version>5.5.6</rest-assured.version>

        <!-- ОБЪЯВЛЕННЫЕ ГРАНИЦЫ СОВМЕСТИМОСТИ — здесь и только здесь.
             README и AllureApiCanaryTest читают ЭТИ числа (канарейка — через
             systemPropertyVariables ниже), поэтому разъехаться они не могут.
             Меняешь число → обязан прогнать соответствующий compat-профиль. -->
        <compat.allure.min>2.20.0</compat.allure.min>
        <compat.allure.max>2.35.4</compat.allure.max>
        <compat.boot.min>3.2.12</compat.boot.min>

        <!-- Версия CLI-генератора отчёта РАСЦЕПЛЕНА с версией библиотеки: матрица меняет
             allure.version, и без расцепления она заодно меняла бы генератор — а это разные
             вещи (одна про наш байткод, другая про дистрибутив, который качается из сети). -->
        <allure-report.version>2.25.0</allure-report.version>

        <!-- Сверка инвентаря с эталоном. `off` допустим ТОЛЬКО внутри compat-профилей —
             стережёт unit/PomCompatibilityTest. Эталон принадлежит нашей комбинации версий,
             на чужой он краснел бы законно, поэтому там печатаем дельту человеку. -->
        <inventory.compare>on</inventory.compare>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- НАШИ пины идут ПЕРВЫМИ: dependencyManagement разрешается сверху вниз, и первое
                 совпадение побеждает. Переопределить версию из импортируемого BOM одноимённым
                 свойством нельзя — свойства BOM вычисляются в его собственном контексте. -->
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <!-- Версии Spring/Logback/JUnit/AssertJ берём из Spring Boot BOM,
                 чтобы совпадать с тем, что уже есть у потребителя. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Allure API: Allure.addAttachment / Allure.step. Единственная зависимость,
             которую потребитель может не иметь напрямую — оставляем compile. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
        </dependency>

        <!-- Всё ниже потребитель уже имеет в test-scope (spring-boot-starter-test).
             provided — чтобы не навязывать версии и не тянуть транзитивно. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- spring-web: RestTemplate + HTTP-клиентские типы (перехват RestTemplate/TestRestTemplate) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- spring-webflux: типы WebTestClient (реактивный тест-клиент) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Модуль HTTP MockMvc: @AutoConfiguration/@ConditionalOnClass и
             MockMvcBuilderCustomizer. У потребителя это есть в test-scope, поэтому provided
             (не тянем транзитивно); модуль сам не активируется без MockMvc на classpath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Модуль HTTP RestAssured. Все feature-зависимости держим в provided
             (потребитель имеет их в test-scope; транзитивно не навязываем, активация —
             только при наличии класса на classpath). -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Модуль БД/JPA: AspectJ (для @Aspect/@Around) и JPA-аннотации (детект @Entity).
             provided — у потребителя это есть в test-scope; без них модуль не активируется. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Модуль прямого JDBC: JdbcTemplate/NamedParameterJdbcTemplate (байткод-перехват).
             provided — у потребителя spring-jdbc есть в test-scope; без него модуль не активируется. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Модуль WireMock: provided — активируется, только если WireMock на classpath
             потребителя; не в Spring Boot BOM — версия явно. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>provided</scope>
        </dependency>

        <!-- Модуль ассертов (ByteBuddy): инструментирование байткода. provided —
             у потребителя byte-buddy есть в test-scope (тянет mockito/spring-boot-test). -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Модуль AssertJ: для isSubTypeOf(AbstractAssert). provided — assertj есть у
             потребителя в test-scope (spring-boot-starter-test). -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Модуль Mockito: кастомный MockMaker. provided — mockito есть у потребителя
             в test-scope (spring-boot-starter-test). -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Модуль Kafka: kafka-clients для advice (ConsumerRecords/ProducerRecord).
             provided — у потребителя есть, если он пишет тесты с Kafka. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Модуль Liquibase: перехват применения changeset'ов (байткод). provided —
             liquibase-core есть у потребителя в test-scope, если он пользуется миграциями;
             без него модуль не активируется. Версия — из Spring Boot BOM. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Модуль Awaitility: ловим await()...until() через официальный SPI
             (ConditionEvaluationListener). provided — awaitility есть у потребителя в test-scope,
             если он им пользуется; без него модуль не активируется. Версия — из Spring Boot BOM. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- datasource-proxy: наш механизм логирования реального SQL. optional —
             как и прочие feature-зависимости, не навязываем транзитивно; модуль
             активируется, только если datasource-proxy есть на classpath потребителя
             (в нашей сборке он есть — SQL в нашем отчёте работает). Нет в Boot BOM — версия явно. -->
        <dependency>
            <groupId>net.ttddyy</groupId>
            <artifactId>datasource-proxy</artifactId>
            <version>1.10.1</version>
            <optional>true</optional>
        </dependency>

        <!-- Тесты: самопроверка (уровень A) и живой отчёт (уровень B). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- для живого MockMvc-теста (поднять MVC-слой с тестовым контроллером) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- для живого БД-теста: JPA + AOP + H2 (без Docker) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <!-- ⚠️ В Boot 4.x этот артефакт ПЕРЕИМЕНОВАН в spring-boot-starter-aspectj: в ветке
                 апгрейда будет второй «version is missing». Пинить версию бессмысленно (артефакта
                 с таким именем там нет) — правка принадлежит ветке апгрейда. -->
            <artifactId>spring-boot-starter-aop</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- для живого Kafka-теста: spring-kafka + встроенный брокер (без Docker) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- сохранять имена параметров: нужно Spring MVC (@PathVariable/@RequestParam) -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- помимо *Test гоняем и *IT (живой отчёт ReportSmokeIT) в обычном test-phase -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- СЛУЧАЙНЫЙ порядок тест-классов: тесты НЕ должны зависеть от порядка
                         (порядок методов рандомизит junit-platform.properties). Любая будущая
                         завязка на порядок упадёт сразу, а не «иногда». -->
                    <runOrder>random</runOrder>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        <!-- границы из <properties>: единственный источник правды -->
                        <allure.compat.min>${compat.allure.min}</allure.compat.min>
                        <allure.compat.max>${compat.allure.max}</allure.compat.max>
                        <inventory.compare>${inventory.compare}</inventory.compare>
                    </systemPropertyVariables>
                    <!-- Self-attach byte-buddy-агента (ByteBuddyAgent.install) на JDK 21+ печатает
                         предупреждение, а в будущих JDK может быть запрещён по умолчанию (JEP 451).
                         Разрешаем явно: иначе весь байткод-слой ТИХО выключится.
                         ⚠️ Если в проекте появится jacoco — писать «@{argLine} -XX:+…», иначе его
                         argLine затрётся и покрытие пропадёт молча. -->
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <!-- Инвентарь гоняется ОТДЕЛЬНЫМ прогоном (профиль report-inventory):
                                 в основном ему нечего проверять — результаты ещё пишутся.
                                 Правило записано, а не подразумевается именем класса. -->
                            <excludes>
                                <exclude>**/inventory/ReportInventoryCheck.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Каталог результатов чистим ПЕРЕД тестами, а не только в `mvn clean`: иначе
                 CurrentReport.anyResultFileContains (сканирует ВЕСЬ каталог) и инвентарь читают
                 файлы прошлых прогонов — ложно-зелёный ровно там, где ловим тихую поломку. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>wipe-allure-results</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <!-- ОБЯЗАТЕЛЬНО: иначе цель clean снесёт весь target/ посреди сборки -->
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <failOnError>false</failOnError>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.directory}/allure-results</directory>
                                </fileset>
                                <!-- дампы диагностики перехвата — та же болезнь: если основная JVM
                                     умрёт до закрытия сессии (симптом сломанного агента!), гейт
                                     прочитал бы файл ПРОШЛОГО прогона и промолчал -->
                                <fileset>
                                    <directory>${project.build.directory}/instrumentation-diagnostics</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Allure CLI: mvn allure:serve / allure:report -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <!-- НЕ ${allure.version}: матрица меняет версию БИБЛИОТЕКИ, а не генератора
                         отчёта. Связка заставляла бы compat-профиль качать чужой дистрибутив CLI
                         и давала бы ложный сигнал «сломалось на старом Allure». -->
                    <reportVersion>${allure-report.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                </configuration>
            </plugin>

            <!-- Имя модуля JPMS фиксируем заранее (до module-info): стабильно для потребителей -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.kolomyychenkoai.allure.spring</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Готовим артефакты к Maven Central (подпись gpg и публикацию настроим позже) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                    <!-- Внутренние пакеты (.internal) — не публичный API, в javadoc не нужны;
                         заодно убирает ошибку «mockito.internal не виден» из MockitoInternals. -->
                    <excludePackageNames>
                        io.github.kolomyychenkoai.allure.spring.internal:io.github.kolomyychenkoai.allure.spring.rest.internal:io.github.kolomyychenkoai.allure.spring.data.internal:io.github.kolomyychenkoai.allure.spring.kafka.internal:io.github.kolomyychenkoai.allure.spring.wiremock.internal:io.github.kolomyychenkoai.allure.spring.assertion.internal:io.github.kolomyychenkoai.allure.spring.mock.internal:io.github.kolomyychenkoai.allure.spring.liquibase.internal:io.github.kolomyychenkoai.allure.spring.awaitility.internal
                    </excludePackageNames>
                    <!-- AllureMockitoMockMaker — opt-in SPI-реализация: оборачивает приватный
                         mockito InlineByteBuddyMockMaker (mockito-core — JPMS-модуль, internal не
                         экспортит → javadoc его не видит). Из публичных доков исключаем; класс
                         остаётся public, активируется через SPI-файл (см. README). -->
                    <sourceFileExcludes>
                        <sourceFileExclude>**/mock/AllureMockitoMockMaker.java</sourceFileExclude>
                    </sourceFileExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadoc</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ВТОРОЙ прогон, ОТДЕЛЬНАЯ JVM: инвентарь видов шагов против эталона. К его старту
             основной прогон завершён и все result.json на диске.

             Профиль, а не просто execution: user-property `test` перебивает <includes> у ВСЕХ
             executions сразу, поэтому `mvn test -Dtest=KafkaReportIT` гонял бы KafkaReportIT
             ДВАЖДЫ (второй встроенный брокер, дубли в allure-results). Активация по отсутствию
             `test` выключает второй прогон целиком: точечный запуск снова стоит один прогон,
             а инвентарь на неполных данных всё равно бессмыслен. -->
        <profile>
            <id>report-inventory</id>
            <activation>
                <property>
                    <name>!test</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>report-inventory</id>
                                <phase>test</phase>
                                <goals><goal>test</goal></goals>
                                <configuration>
                                    <includes>
                                        <include>**/inventory/ReportInventoryCheck.java</include>
                                    </includes>
                                    <excludes combine.self="override"/>
                                    <runOrder>filesystem</runOrder>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ══════════════ МАТРИЦА СОВМЕСТИМОСТИ ══════════════
             Все профили ниже НЕ активны по умолчанию: ежедневный `mvn clean test` не меняется.
             Гоняются перед релизом и при любой правке compat.* — одной командой
             scripts/compat-matrix.sh. Подробности: docs/compat-matrix.md. -->

        <!-- Java 25 на нашей комбинации библиотек. Форкаем ТОЛЬКО тесты, компиляция остаётся
             release=21: проверяем ровно то, что получит потребитель — jar под 21 на JVM 25.
             Maven и его плагины остаются на 21, поэтому при поломке подозреваемый один.
             <jvm> стоит в общей <configuration> → наследуется и прогоном инвентаря. -->
        <profile>
            <id>java25</id>
            <properties>
                <!-- brew install openjdk@25. Перебить: -Djava25.home=$(jenv prefix 25) -->
                <java25.home>/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home</java25.home>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <jvm>${java25.home}/bin/java</jvm>
                            <systemPropertyVariables>
                                <!-- Без этого профиль ничего не ДОКАЗЫВАЕТ: укажи java25.home на
                                     JDK 21 — и он зеленеет, а строка «проверено до 25» в README
                                     врёт. Канарейка сверяет число с Runtime.version().feature(). -->
                                <expected.java.feature>25</expected.java.feature>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Нижняя граница Allure. Пересобирает main против неё → компилятор первая линия,
             AllureApiCanaryTest вторая, а его проверка рантайм-версии убеждается, что
             объявленная граница не соврала. Инвентарь сверяем: версия Allure не меняет ни
             одного нашего шага (мы их формируем сами), значит расхождение = настоящий сигнал. -->
        <profile>
            <id>compat-allure-min</id>
            <properties>
                <allure.version>${compat.allure.min}</allure.version>
            </properties>
        </profile>

        <profile>
            <id>compat-allure-max</id>
            <properties>
                <allure.version>${compat.allure.max}</allure.version>
            </properties>
        </profile>

        <!-- Нижняя граница Spring Boot: меняется ВЕСЬ BOM (Spring 6.1, Hibernate 6.4,
             Liquibase 4.2x, Kafka 3.6, byte-buddy 1.14.x, JUnit 5.10, AssertJ 3.24).
             Форма SQL Hibernate и служебный SQL Liquibase поедут ЗАКОННО → сверку с эталоном
             выключаем, дельту печатаем человеку. Безусловные гейты остаются жёсткими. -->
        <profile>
            <id>compat-boot-min</id>
            <properties>
                <spring-boot.version>${compat.boot.min}</spring-boot.version>
                <inventory.compare>off</inventory.compare>
            </properties>
        </profile>
    </profiles>
</project>
